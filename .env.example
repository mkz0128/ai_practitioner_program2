# 應用程式
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/runtime/dispatch.db
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OpenAI：提交檔案中維持空白金鑰。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRACING_ENABLED=true
OPENAI_TRACE_INCLUDE_SENSITIVE_DATA=false

# Agent denial-of-wallet 限制
AGENT_MAX_TURNS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_TOTAL_TOKENS=30000
AGENT_WARN_TOTAL_TOKENS=20000
AGENT_MAX_WALL_CLOCK_SECONDS=120
AGENT_MAX_PROVIDER_RETRIES=2

# Google Maps Platform
# Browser 與 server keys 必須分離，並各自套用限制。
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_ROUTES_SERVER_API_KEY=
GOOGLE_ROUTES_ENABLED=false
GOOGLE_ROUTES_TIMEOUT_SECONDS=10
GOOGLE_ROUTES_CACHE_TTL_SECONDS=900

# TDX
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
TDX_ENABLED=false
TDX_TIMEOUT_SECONDS=10

# 確定性 Demo providers
ROUTE_PROVIDER=simulated
TRAFFIC_PROVIDER=simulated
SIMULATED_CONGESTION_ENABLED=true
SIMULATION_SEED=20260901
