{
  "version": 2,
  "format": "json_yaml_1_2_compatible",
  "observability": {
    "enabled": true,
    "mode": "structured_json_events",
    "clock": "utc",
    "output_directory": ".agent/runs",
    "file_pattern": "{utc_timestamp}-{agent_run_id}.jsonl"
  },
  "correlation": {
    "required_when_available": ["request_id", "dataset_id", "plan_id", "plan_version", "agent_run_id"],
    "propagate_request_id_header": "X-Request-ID"
  },
  "trajectory": {
    "capture": [
      "request_received",
      "phase_gate_checked",
      "context_loaded",
      "tool_started",
      "tool_finished",
      "dataset_validated",
      "optimizer_started",
      "optimizer_finished",
      "plan_validated",
      "plan_state_changed",
      "provider_fallback_activated",
      "approval_requested",
      "approval_received",
      "error_observed",
      "request_finished"
    ],
    "record": ["concise_decision_summary", "evidence_ids_and_numeric_summary", "provider_mode", "error_code", "status_transition"],
    "never_record": ["private_chain_of_thought", "api_keys_or_tokens", "authorization_headers", "full_excel_contents", "customer_pii"]
  },
  "metrics": {
    "latency_ms": ["api_total", "optimizer", "plan_validator", "provider_google_routes", "provider_tdx", "provider_openai"],
    "counters": ["tool_calls_total", "tool_failures_total", "provider_fallbacks_total", "validation_errors_total", "unassigned_orders_total", "plan_state_transitions_total"],
    "agent_usage": ["model", "input_tokens", "cached_input_tokens", "output_tokens", "total_tokens", "estimated_cost_usd"],
    "cost_rule": "成本只能依具日期的 provider pricing snapshot 計算；否則只記錄 token 用量。"
  },
  "limits": {
    "enforcement": "fail_closed",
    "max_agent_turns_per_request": 8,
    "max_tool_calls_per_request": 12,
    "max_same_tool_consecutive_calls": 2,
    "max_total_tokens_per_request": 30000,
    "warn_total_tokens_per_request": 20000,
    "max_wall_clock_seconds_per_request": 120,
    "max_provider_retries": 2,
    "provider_retry_backoff": "bounded_exponential_with_jitter",
    "loop_detection": {
      "repeated_tool_and_arguments_limit": 2,
      "no_progress_event_limit": 3
    },
    "on_limit": {
      "status": "LIMIT_REACHED",
      "preserve_partial_evidence": true,
      "allow_side_effect": false
    }
  },
  "openai_agents_sdk": {
    "tracing_enabled_env": "OPENAI_TRACING_ENABLED",
    "include_sensitive_data_env": "OPENAI_TRACE_INCLUDE_SENSITIVE_DATA",
    "include_sensitive_data_default": false,
    "exporter": "configurable",
    "usage_source": "run_context_usage",
    "trace_metadata_allowlist": ["request_id", "dataset_id", "plan_id", "plan_version", "workflow_name", "provider_mode"]
  },
  "tool_events": {
    "record_input": "schema_and_redacted_summary",
    "record_output": "schema_and_redacted_summary",
    "record_fields": ["tool_name", "success", "duration_ms", "input_record_count", "output_record_count", "evidence_ids", "error_type"],
    "payload_max_characters": 4000
  },
  "redaction": {
    "enabled": true,
    "replacement": "[REDACTED]",
    "field_name_patterns": ["password", "passwd", "secret", "token", "api_key", "authorization", "cookie", "private_key", "client_secret"]
  },
  "artifacts": {
    "hash_algorithm": "sha256",
    "record_before_after_hash": true,
    "record_diff_summary": true,
    "store_full_file_contents": false
  },
  "retention": {
    "local_days": 30,
    "include_in_version_control": false,
    "deletion_requires_human_approval": true
  },
  "quality_gates": {
    "require_phase_gate_event": true,
    "require_independent_plan_validation": true,
    "require_verification_before_complete": true,
    "require_approval_event_for_plan_confirmation": true,
    "require_approval_id_for_risk_levels": ["L2", "L3"]
  }
}
